# secrets - never commit
#
# Ignore EVERY .env variant, including backups and odd suffixes like
# .env.local.ohio-backup, then allow back the two that are deliberately
# public. A denylist misses the file you did not think of; an allowlist
# cannot.
.env*
*.env
*.env.*
*-backup
*.bak

# ...except these, which contain no secrets and must be committed
!deploy-secrets.env.example
!frontend/.env.production

# python
__pycache__/
*.py[cod]
venv/
.venv/

# data
data/raw/
*.sqlite3

# logs
logs/

# neon cli local link (org/project ids)
.neon

# deploy tokens - never commit
deploy-secrets.env
RENDER_ENV_VARS.txt
