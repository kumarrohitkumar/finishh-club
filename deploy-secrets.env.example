# Copy this file to  deploy-secrets.env  and fill it in.
# That file is gitignored and never leaves your machine.
#
# VERCEL_TOKEN
#   https://vercel.com/account/tokens  ->  Create Token
#   Scope: Full Account.  Expiry: 1 day is plenty.
#
# RENDER_API_KEY
#   https://dashboard.render.com/u/settings#api-keys  ->  Create API Key
#
# Delete both tokens after the deploy. They are short-lived by design.

VERCEL_TOKEN=
RENDER_API_KEY=
